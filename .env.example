PORT=3000
# PUBLIC_URL="http://127.0.0.1:3000/"

SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
STORED_SETTINGS_FILE="./settings.json"

HIDE_EXPLICIT=false
EXPOSE_PAUSED_PLAYBACK=false
ALLOW_STATIC=false
SSE_ALLOW_ORIGIN="*"
# Optional. Defaults to true for https PUBLIC_URL values and false for http.
# STATE_COOKIE_SECURE=false
# Trust X-Forwarded-For only when requests arrive through these proxies.
# TRUST_PROXY="loopback,uniquelocal"
# EXPRESS_TRUST_PROXY is supported as a legacy fallback.
